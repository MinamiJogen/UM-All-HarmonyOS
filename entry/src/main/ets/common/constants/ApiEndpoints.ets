export function buildArkApiUrl(path: string): string {
  return ARK_API_BASE + path;
}

export function buildCourseApiUrl(path: string): string {
  return COURSE_API_BASE + path;
}

export function buildHarborAvatarUrl(username: string): string {
  return ARK_HARBOR + '/user_avatar/harbor.umall.one/' + encodeURIComponent(username) + '/16/52_2.png';
}

export function ARK_HARBOR_AVATAR(username: string): string {
  return buildHarborAvatarUrl(username);
}

export function buildWikiSearchUrl(keyword: string): string {
  return ARK_WIKI_SEARCH + encodeURIComponent(keyword);
}

export function buildOfficialCourseUrl(courseCode: string): string {
  return OFFICIAL_COURSE_SEARCH + encodeURIComponent(courseCode);
}

export function addArkHost(path: string): string {
  if (path.length === 0 || path.startsWith('http://') || path.startsWith('https://')) {
    return path;
  }
  return ARK_SITE_BASE + path;
}

export function addHost(path: string): string {
  return addArkHost(path);
}
