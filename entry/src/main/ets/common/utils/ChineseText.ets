export function hasChinese(input: string): boolean {
  return /[\u4E00-\u9FA5]+/g.test(input);
}

export function normalizeSimplifiedChinese(input: string): string {
  // TODO: replace this narrow search map with OpenCC or an equivalent ArkTS package when available.
